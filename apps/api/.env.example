# Example environment for API service
# In development, copy to .env and adjust as needed
JWT_SECRET=dev-secret
DATABASE_URL="file:./dev.db"
PORT=3001

# Request logging emits privacy-safe JSON completion records to stdout.
# LOG_LEVEL accepts Pino levels: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info
# REQUEST_LOGGING_ENABLED accepts true or false. Defaults to true outside tests and false in NODE_ENV=test.
REQUEST_LOGGING_ENABLED=true
