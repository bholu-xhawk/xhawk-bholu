# Example environment for API service
# In development, copy to .env and adjust as needed.
# Configuration changes require an API process restart.
JWT_SECRET=dev-secret
DATABASE_URL="file:./dev.db"
PORT=3001

# Login abuse protection: fixed-window, process-local limiter for POST /api/auth/login.
# Each client IP gets five attempts per 15 minutes by default. Malformed,
# failed, and successful attempts all consume the same budget.
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_MAX_REQUESTS=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Optional Express trusted proxy hop count. Leave unset when no trusted proxy is
# present. When set, this must match the verified trusted ingress chain exactly;
# incorrect values can merge clients or allow spoofed client IPs.
# TRUST_PROXY_HOPS=1

# The login limiter stores counters in this one API process only. Restarts clear
# all counters, and multiple API processes enforce independent limits unless a
# shared atomic rate-limit store is implemented.
